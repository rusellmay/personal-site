  function setLang(lang){
    var dict = I18N[lang] || I18N.es;
    document.documentElement.lang = lang;
    document.title = dict["doc-title"];
    var metaDesc = document.querySelector("meta[name=\"description\"]");
    if (metaDesc && dict["doc-desc"] !== undefined) metaDesc.setAttribute("content", dict["doc-desc"]);
    document.querySelectorAll("[data-i18n]").forEach(function(el){
      var k = el.getAttribute("data-i18n");
      if (dict[k] !== undefined) el.innerHTML = dict[k];
    });
    document.querySelectorAll("[data-i18n-aria]").forEach(function(el){
      var k = el.getAttribute("data-i18n-aria");
      if (dict[k] !== undefined) el.setAttribute("aria-label", dict[k]);
    });
    var esBtn = document.getElementById("langEs"), enBtn = document.getElementById("langEn");
    if (esBtn && enBtn){
      esBtn.classList.toggle("active", lang === "es"); esBtn.setAttribute("aria-pressed", lang === "es" ? "true" : "false");
      enBtn.classList.toggle("active", lang === "en"); enBtn.setAttribute("aria-pressed", lang === "en" ? "true" : "false");
    }
  }
  var esBtn = document.getElementById("langEs"), enBtn = document.getElementById("langEn");
  if (esBtn) esBtn.addEventListener("click", function(){ setLang("es"); });
  if (enBtn) enBtn.addEventListener("click", function(){ setLang("en"); });
  // Default language is Spanish: apply it on load so the page opens in
  // Spanish even though the markup defaults are English. This runs
  // synchronously at the end of <body>, before first paint, so Spanish
  // users do not see a flash of English.
  setLang("es");
  window.__setLang = setLang;
})();
</script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
<script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
<script is:inline>
(function(){
  var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  var hasGsap = typeof gsap !== "undefined";
  function showAll(){
    document.querySelectorAll(".reveal").forEach(function(el){ el.style.opacity = 1; });
    document.querySelectorAll("[data-count]").forEach(function(el){ el.textContent = el.getAttribute("data-count"); });
  }
  if (!hasGsap || reduced) { showAll(); return; }
  gsap.registerPlugin(ScrollTrigger);
  var cursor = document.getElementById("cursor");
  var cx = gsap.quickTo(cursor, "x", {duration:.35, ease:"power3"});
  var cy = gsap.quickTo(cursor, "y", {duration:.35, ease:"power3"});
  gsap.set(cursor, {xPercent:-50, yPercent:-50, x:-100, y:-100});
  window.addEventListener("mousemove", function(e){ cx(e.clientX); cy(e.clientY); });
  document.querySelectorAll("a, .lang-toggle button").forEach(function(el){
    el.addEventListener("mouseenter", function(){ cursor.classList.add("is-hover"); gsap.to(cursor, {scale:2, duration:.3}); });
    el.addEventListener("mouseleave", function(){ cursor.classList.remove("is-hover"); gsap.to(cursor, {scale:1, duration:.3}); });
  });
  gsap.to("#progress", { scaleX:1, ease:"none", scrollTrigger:{ trigger:document.body, start:"top top", end:"bottom bottom", scrub:.3 } });
  var tl = gsap.timeline({defaults:{ease:"power4.out"}});
  tl.from("h1.display .line > span", {yPercent:115, duration:1.15, stagger:.09})
    .from(".hero-fade", {y:26, opacity:0, duration:.9, stagger:.1}, "-=.7")
    .from(".devcard", {y:56, opacity:0, rotate:2.5, duration:1.1, ease:"power3.out"}, "-=.8")
    .from("[data-float]", {y:10, opacity:0, scale:.94, duration:.7, stagger:.15, ease:"back.out(2)"}, "-=.6");
  gsap.to("[data-float]", { y:"-=5", duration:2.8, ease:"sine.inOut", yoyo:true, repeat:-1, stagger:.5 });
  gsap.to(".orb-1", { y:90, scrollTrigger:{ trigger:".hero", start:"top top", end:"bottom top", scrub:1 } });
  gsap.to(".orb-2", { rotate:120, scrollTrigger:{ trigger:".hero", start:"top top", end:"bottom top", scrub:1 } });
  gsap.to("#marqueeTrack", { xPercent:-50, duration:26, ease:"none", repeat:-1 });
  gsap.utils.toArray(".reveal").forEach(function(el){
    gsap.fromTo(el, {y:44, opacity:0}, { y:0, opacity:1, duration:1, ease:"power3.out", scrollTrigger:{ trigger:el, start:"top 86%" } });
  });
  document.querySelectorAll("[data-count]").forEach(function(el){
    var end = parseFloat(el.getAttribute("data-count")); var obj = {v:0};
    ScrollTrigger.create({ trigger:el, start:"top 88%", once:true, onEnter:function(){
      gsap.to(obj, { v:end, duration:1.4, ease:"power2.out", onUpdate:function(){ el.textContent = Math.round(obj.v); } });
    }});
  });
  /* Magnetic button pull removed: translating a button toward the cursor
     slid it sideways over the button next to it in the CTA rows (the
     overlap in the report). Buttons now stay in place; their only hover
     motion is the 2px upward lift defined in CSS, which cannot overlap
     a neighbour. */
})();
</script>
