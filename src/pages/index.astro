            <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
          </div>
          <div class="code" aria-hidden="true" data-i18n="code-block"><span class="c"># who I am</span>
<span class="k">const</span> <span class="fn">rusell</span> = {'{'}
  role: <span class="s">"full-stack developer"</span>,
